# ============================================================
# CIRT DevOps — .gitignore
# ============================================================

# Maven build output
target/
!.mvn/wrapper/maven-wrapper.jar
!**/src/main/**/target/
!**/src/test/**/target/

# IntelliJ IDEA
.idea/
*.iws
*.iml
*.ipr

# Eclipse / STS
.apt_generated
.classpath
.factorypath
.project
.settings
.springBeans
.sts4-cache

# VS Code
.vscode/

# Spring Boot local config (override, may contain local passwords)
application-local.properties
application-local.yml

# OS files
.DS_Store
Thumbs.db

# Logs
*.log
logs/

# Environment variable files (never commit real credentials)
.env
.env.*

# Compiled class files
*.class

# Jar / War / Ear
*.jar
*.war
*.ear

# Package lock files (Maven handles dependencies)
package-lock.json
node_modules/
